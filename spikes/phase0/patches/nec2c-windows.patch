+#ifdef _WIN32
+/* Minimal getopt() replacement for the Windows build.  Supports the
+   option forms used by nec2c: -i FILE, -iFILE, -o FILE, -oFILE, -h, -v. */
+static char *optarg = NULL;
+static int optind = 1;
+
+static int getopt(int argc, char **argv, const char *optstring)
+{
+  const char *arg;
+  const char *p;
+  char opt;
+
+  if (optind >= argc)
+    return -1;
+
+  arg = argv[optind];
+  if (arg[0] != '-' || arg[1] == '\0')
+    return -1;
+  if (strcmp(arg, "--") == 0)
+  {
+    optind++;
+    return -1;
+  }
+
+  opt = arg[1];
+  p = strchr(optstring, opt);
+  if (p == NULL || opt == ':')
+  {
+    optind++;
+    return '?';
+  }
+
+  if (p[1] == ':')
+  {
+    if (arg[2] != '\0')
+    {
+      optarg = (char *)&arg[2];
+      optind++;
+    }
+    else if (optind + 1 < argc)
+    {
+      optarg = argv[optind + 1];
+      optind += 2;
+    }
+    else
+    {
+      optind++;
+      return '?';
+    }
+  }
+  else
+  {
+    optind++;
+  }
+
+  return opt;
+}
+#endif
+
 /* signal handler */
