--- a/misc.c
+++ b/misc.c
@@ -77,12 +77,16 @@
 /* Returns process time (user+system) BUT in _msec_ */
 void secnds( double *x)
 {
+#ifdef _WIN32
+  *x = 1000.0 * (double)clock() / (double)CLOCKS_PER_SEC;
+#else
   struct tms buffer;
   double clk_tck;
 
   times(&buffer);
   clk_tck = sysconf( _SC_CLK_TCK );
   *x = 1000.0 * (double)(buffer.tms_utime + buffer.tms_stime) / clk_tck;
+#endif
 
   return;
 }
